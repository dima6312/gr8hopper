{
  "name": "gr8hopper",
  "version": "1.2.1",
  "description": "A lightweight, portable URL redirect service with configurable templates",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "gr8hopper": "dist/cli.js"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:bun": "bun src/server.ts",
    "deploy": "wrangler deploy --config wrangler.production.toml",
    "cf-typegen": "wrangler types",
    "import:routes": "node scripts/import-routes.cjs",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "eslint --max-warnings=0"
    ]
  },
  "files": [
    "dist/",
    "examples/",
    "scripts/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "keywords": [
    "redirect",
    "url-shortener",
    "cloudflare-workers",
    "hono",
    "url-redirect",
    "link-management",
    "affiliate-links",
    "campaign-tracking",
    "edge-computing",
    "serverless",
    "docker"
  ],
  "author": "Dmytro Kolyvai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dima6312/gr8hopper.git"
  },
  "bugs": {
    "url": "https://github.com/dima6312/gr8hopper/issues"
  },
  "homepage": "https://github.com/dima6312/gr8hopper#readme",
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@eslint/js": "^9.39.2",
    "@iarna/toml": "^2.2.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.51.0",
    "wrangler": "^4.54.0"
  }
}
